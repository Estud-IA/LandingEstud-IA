# ── Dependencias ──────────────────────────────
node_modules/
.pnpm-store/

# ── Build y cachés de Astro / Vite ────────────
dist/
.astro/
.vite/
.cache/
*.tsbuildinfo

# ── Variables de entorno y secretos ───────────
.env
.env.*
!.env.example

# ── Despliegue (configuración local de los proveedores) ──
.vercel/
.netlify/
.wrangler/

# ── APK y binarios de la app ──────────────────
# El APK se aloja fuera del repo (ver docs/03-arquitectura/descarga-y-versiones.md).
*.apk
*.aab
*.keystore
*.jks

# ── Material de trabajo pesado ────────────────
# Grabaciones en bruto antes de comprimir; solo se suben las versiones finales de public/media/.
media-bruto/
*.mov

# ── Reportes y pruebas ────────────────────────
coverage/
lighthouse-*.html
lighthouse-*.json
*.heapsnapshot
*.cpuprofile

# ── Logs ──────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# ── Claude Code: ajustes personales y skills ──
# Las skills se instalan en cada equipo; no se suben al repo.
.claude/settings.local.json
.claude/skills/
.agents/
skills-lock.json

# ── Editores ──────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp

# ── Sistema operativo ─────────────────────────
.DS_Store
Thumbs.db
desktop.ini
