---
/**
 * "Aprender suma" (docs/04-diseno/secciones.md §5, RF-09): cuadrícula irregular de tarjetas con
 * nivel, racha, XP por acierto, insignias, Vcoins, ranking y mensaje destacado. Las tarjetas entran
 * escalonadas (stagger), los números cuentan desde 0 (counter) y la barra se llena (fill). Sin JS
 * se ven los valores finales.
 */
import EncabezadoSeccion from '../components/EncabezadoSeccion.astro';
import TactileCard from '../components/TactileCard.astro';
import InsigniaNivel from '../components/InsigniaNivel.astro';
import BarraXp from '../components/BarraXp.astro';
import ChipXp from '../components/ChipXp.astro';
import Icon from '../components/Icon.astro';
import Avatar from '../components/Avatar.astro';
import Burbuja from '../components/Burbuja.astro';

const logros = [
  { icono: 'award', fondo: 'var(--color-marca)', nombre: 'Top 10 %' },
  { icono: 'star', fondo: 'var(--color-acento)', nombre: 'Maestro' },
  { icono: 'target', fondo: 'var(--lavanda-100)', nombre: 'Puntería' },
];

const ranking = [
  { ini: 'SR', color: 'menta', nombre: 'sofi.rios', xp: '1.420' },
  { ini: 'LU', color: 'lavanda', nombre: 'luciana', xp: '1.310' },
  { ini: 'AT', color: 'amarillo', nombre: 'Tú · #4 ↑2', xp: '1.240', propio: true },
] as const;
---

<section class="gamificacion" aria-labelledby="titulo-gamificacion">
  <div class="contenedor">
    <EncabezadoSeccion
      id="titulo-gamificacion"
      titulo="Aprender suma"
      apoyo="Cada clase, cada respuesta y cada racha cuentan."
    />

    <div class="bento" data-motion="stagger">
      <TactileCard tono="amarillo" class="grande">
        <InsigniaNivel nivel={12} class="bento-nivel" />
        <div class="bento-grupo">
          <h3>Sube de nivel mientras aprendes</h3>
          <BarraXp progreso={0.72} etiqueta="Progreso hacia el nivel 13" animar />
          <p class="bento-dato">1.080 / 1.500 XP para el nivel 13</p>
        </div>
      </TactileCard>

      <TactileCard tono="menta">
        <Icon name="zap" size="2rem" />
        <div>
          <p class="cifra">
            <span data-motion="counter" data-hasta="7">
              7
            </span>{' '}
            días
          </p>
          <h3>de racha</h3>
        </div>
      </TactileCard>

      <TactileCard>
        <ChipXp class="bento-chip">+15 XP</ChipXp>
        <div>
          <h3>Por cada acierto</h3>
          <p>Responde las trivias en vivo.</p>
        </div>
      </TactileCard>

      <TactileCard>
        <ul class="fila-logros" role="list">
          {logros.map((l) => (
            <li style={`--c: ${l.fondo}`}>
              <Icon name={l.icono} label={`Insignia ${l.nombre}`} />
            </li>
          ))}
        </ul>
        <div>
          <h3>Insignias</h3>
          <p>Desbloquea logros por constancia.</p>
        </div>
      </TactileCard>

      <TactileCard tono="lavanda">
        <p class="cifra">
          <span data-motion="counter" data-hasta="350">
            350
          </span>
        </p>
        <div>
          <h3>Vcoins</h3>
          <p>Gánalas gratis y canjéalas por mensajes destacados.</p>
        </div>
      </TactileCard>

      <TactileCard class="ancha">
        <h3>Ranking en tiempo real</h3>
        <ol class="mini-ranking" role="list">
          {ranking.map((r) => (
            <li data-propio={'propio' in r ? '' : undefined}>
              <Avatar iniciales={r.ini} color={r.color} tam="30px" />
              {r.nombre}
              <b>{r.xp} XP</b>
            </li>
          ))}
        </ol>
      </TactileCard>

      <TactileCard tono="menta" class="ancha">
        <h3>Destaca tu pregunta</h3>
        <Burbuja iniciales="AT" autor="ana.torres · destacado">
          ¿Puede explicar otra vez la doble rendija?
        </Burbuja>
        <p class="bento-dato">Canjea tus Vcoins para que tu mensaje no se pierda en el chat.</p>
      </TactileCard>
    </div>
  </div>
</section>

<style>
  @layer secciones {
    .gamificacion {
      padding-block: var(--espacio-seccion);
    }

    .bento {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      grid-auto-rows: minmax(12rem, auto);
      gap: var(--espacio-5);

      & > :global(*) {
        display: grid;
        align-content: space-between;
        gap: var(--espacio-4);
      }

      & :global(h3) {
        font-size: var(--texto-h3);
      }

      & :global(p) {
        color: var(--color-texto-suave);
      }

      & > :global(.grande) {
        grid-column: span 2;
        grid-row: span 2;
      }

      & > :global(.ancha) {
        grid-column: span 2;
      }

      @media (width < 60rem) {
        grid-template-columns: repeat(2, 1fr);
      }

      @media (width < 36rem) {
        grid-template-columns: 1fr;

        & > :global(.grande),
        & > :global(.ancha) {
          grid-column: auto;
          grid-row: auto;
        }
      }
    }

    .bento-grupo {
      display: grid;
      gap: var(--espacio-3);
    }

    .bento :global(.bento-nivel) {
      justify-self: start;
      font-size: 2.2rem;
    }

    .bento :global(.bento-chip) {
      justify-self: start;
    }

    .bento .bento-dato {
      font-weight: 600;
      color: var(--color-tinta);
    }

    .bento .cifra {
      font-family: var(--fuente-titulos);
      font-weight: 800;
      font-size: clamp(2.5rem, 1.8rem + 2.5vw, 4rem);
      line-height: 1;
      color: var(--color-tinta);
      font-variant-numeric: tabular-nums;
    }

    .fila-logros {
      display: flex;
      gap: var(--espacio-3);

      & li {
        display: grid;
        place-items: center;
        inline-size: 3.25rem;
        block-size: 3.25rem;
        border: var(--borde) solid var(--color-tinta);
        border-radius: 50%;
        background: var(--c);
        box-shadow: var(--sombra-dura-chica);
        --icono-tam: 1.4rem;
      }
    }

    .mini-ranking {
      display: grid;
      gap: var(--espacio-2);

      & li {
        display: flex;
        align-items: center;
        gap: var(--espacio-3);
        padding: 0.45rem 0.75rem;
        border: 2px solid var(--color-tinta);
        border-radius: 12px;
        background: var(--color-superficie);
        font-weight: 600;
        font-size: var(--texto-chico);
      }

      & li[data-propio] {
        background: var(--color-marca);
      }

      & b {
        margin-inline-start: auto;
        font-family: var(--fuente-titulos);
      }
    }
  }
</style>
